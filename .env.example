# Optional. A key the server uses for visitors who have not added their own.
# Image editing needs a key whose Google project has billing enabled; describe mode works on a free key.
# Never prefix this with VITE_, that would put it in the browser bundle.
GEMINI_API_KEY=

# Optional. Point the server route at a different origin (used by the tests with a local mock).
# GEMINI_API_ORIGIN=
